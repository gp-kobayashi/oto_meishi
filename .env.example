# Dockerイメージのビルド時に渡す公開値です。
# ブラウザへ公開されるため、秘密鍵は設定しないでください。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ローカル開発ではhttp://localhost:3000、本番ではhttps://oto-meishi.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# サーバー実行時にSecretとして渡す値です。
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 32文字以上のランダム値を設定し、定期削除APIのBearer認証に使用します。
MODERATION_CLEANUP_SECRET=
# 32文字以上のランダム値。設定後に変更すると既存の再登録禁止記録と照合できなくなります。
ACCOUNT_BAN_HASH_SECRET=

# サーバー実行時に通常の環境変数として渡す値です。
R2_BUCKET=
R2_REGION=auto

# 過去の公開R2 URLをaudioKeyへ変換する場合のみ設定します。
# 新規環境ではR2バケットを非公開にし、この値は空のままにします。
R2_PUBLIC_URL=
