# Dockerイメージのビルド時に渡す公開値です。
# ブラウザへ公開されるため、秘密鍵は設定しないでください。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー実行時にSecretとして渡す値です。
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# サーバー実行時に通常の環境変数として渡す値です。
R2_BUCKET=
R2_REGION=auto

# 過去の公開R2 URLをaudioKeyへ変換する場合のみ設定します。
# 新規環境ではR2バケットを非公開にし、この値は空のままにします。
R2_PUBLIC_URL=
