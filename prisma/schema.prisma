// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  normal
  dark
  light
  colorful
}

enum SocialService {
  x
  instagram
  youtube
  tiktok
  github
  discord
  facebook
  linkedin
  bluesky
  threads
  note
  website
  other
}

enum AdminRole {
  moderator
  admin
}

enum ProfileStatus {
  active
  hidden
  suspended
}

enum AudioModerationStatus {
  active
  hidden
  removed
}

enum SocialLinkModerationStatus {
  active
  hidden
}

enum ModerationTargetType {
  profile
  audio
  socialLink
}

enum ModerationActionType {
  hide
  restore
  suspend
  remove
}

enum AccountModerationStatus {
  active
  suspended
  deletionPending
}

enum ModerationReasonCode {
  inappropriateContent
  copyrightConcern
  harassment
  unsafeLink
  serviceMismatch
  impersonation
  other
}

enum ModerationReviewMode {
  postReview
  preReview
}

enum ModerationCaseStatus {
  correctionRequired
  postReviewPending
  preReviewPending
  confirmed
}

enum ModerationSnapshotKind {
  reported
  corrected
}

enum ModerationActorType {
  admin
  user
  system
}

enum ModerationCaseEventType {
  created
  contentChanged
  contentDeleted
  statusChanged
  reviewApproved
  reviewRejected
  accountSuspended
  appealSubmitted
  accountRestored
  deletionScheduled
  autoConfirmed
}

enum ReportReason {
  inappropriate_audio
  harassment
  unsafe_link
  impersonation
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

model AdminUser {
  id                String             @id @default(uuid()) @db.Uuid
  authId            String             @unique
  role              AdminRole          @default(moderator)
  isActive          Boolean            @default(true)
  moderationActions ModerationAction[]
  reviewedReports   ContentReport[]    @relation("ReportReviewer")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model ModerationAction {
  id             String               @id @default(uuid()) @db.Uuid
  adminUser      AdminUser            @relation(fields: [adminUserId], references: [id])
  adminUserId    String               @db.Uuid
  profileId      String
  targetType     ModerationTargetType
  targetId       String
  action         ModerationActionType
  previousStatus String               @db.VarChar(32)
  newStatus      String               @db.VarChar(32)
  reason         String               @db.VarChar(500)
  createdAt      DateTime             @default(now())
  notification   UserNotification?

  @@index([profileId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([adminUserId, createdAt])
}

model ModerationCase {
  id                 String                @id @default(uuid()) @db.Uuid
  profile            Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId          String
  targetType         ModerationTargetType
  targetId           String
  reasonCode         ModerationReasonCode
  reviewMode         ModerationReviewMode
  status             ModerationCaseStatus  @default(correctionRequired)
  userMessage        String                @db.VarChar(500)
  reviewDueAt        DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP + '60 days'::interval)"))
  retentionExpiresAt DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP + '60 days'::interval)"))
  resolvedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  snapshots          ModerationSnapshot[]
  events             ModerationCaseEvent[]

  @@index([profileId, status, createdAt])
  @@index([status, reviewDueAt])
  @@index([retentionExpiresAt])
  @@index([targetType, targetId, createdAt])
}

model ModerationSnapshot {
  id               String                 @id @default(uuid()) @db.Uuid
  moderationCase   ModerationCase         @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)
  moderationCaseId String                 @db.Uuid
  kind             ModerationSnapshotKind
  content          Json
  contentHash      String?                @db.VarChar(128)
  storageObjectKey String?                @db.VarChar(1024)
  expiresAt        DateTime
  createdAt        DateTime               @default(now())

  @@index([moderationCaseId, kind, createdAt])
  @@index([expiresAt])
}

model ModerationCaseEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  moderationCase   ModerationCase          @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)
  moderationCaseId String                  @db.Uuid
  eventType        ModerationCaseEventType
  actorType        ModerationActorType
  actorId          String?                 @db.VarChar(128)
  previousStatus   ModerationCaseStatus?
  newStatus        ModerationCaseStatus?
  details          Json?
  createdAt        DateTime                @default(now())

  @@index([moderationCaseId, createdAt])
  @@index([eventType, createdAt])
}

model ContentReport {
  id                    String       @id @default(uuid()) @db.Uuid
  profile               Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId             String
  reason                ReportReason
  details               String       @default("") @db.VarChar(500)
  status                ReportStatus @default(pending)
  reviewedByAdminUser   AdminUser?   @relation("ReportReviewer", fields: [reviewedByAdminUserId], references: [id], onDelete: SetNull)
  reviewedByAdminUserId String?      @db.Uuid
  reviewedAt            DateTime?
  reviewNote            String       @default("") @db.VarChar(500)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([profileId, createdAt])
  @@index([reviewedByAdminUserId])
}

model Profile {
  id                      String                  @id @default(uuid())
  userId                  String                  @unique
  authId                  String?                 @unique
  status                  ProfileStatus           @default(active)
  accountModerationStatus AccountModerationStatus @default(active)
  suspensionAppealDueAt   DateTime?
  deletionScheduledAt     DateTime?
  theme                   Theme                   @default(normal)
  displayName             String
  bio                     String
  audioUrl                String
  audioKey                String                  @default("")
  audioTitle              String
  audioStatus             AudioModerationStatus   @default(active)
  sns                     SocialLink[]
  reports                 ContentReport[]
  notifications           UserNotification[]
  moderationCases         ModerationCase[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([status])
  @@index([audioStatus])
  @@index([accountModerationStatus, suspensionAppealDueAt])
  @@index([deletionScheduledAt])
}

model UserNotification {
  id                 String           @id @default(uuid()) @db.Uuid
  profile            Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId          String
  moderationAction   ModerationAction @relation(fields: [moderationActionId], references: [id], onDelete: Cascade)
  moderationActionId String           @unique @db.Uuid
  title              String           @db.VarChar(100)
  message            String           @db.VarChar(300)
  readAt             DateTime?
  createdAt          DateTime         @default(now())

  @@index([profileId, readAt, createdAt(sort: Desc)])
}

model SocialLink {
  id        String                     @id @default(uuid())
  profile   Profile                    @relation(fields: [profileId], references: [id])
  profileId String
  service   SocialService
  url       String
  label     String
  sortOrder Int                        @default(0)
  status    SocialLinkModerationStatus @default(active)

  @@index([profileId])
  @@index([status])
}
