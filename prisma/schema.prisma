// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  normal
  dark
  light
  colorful
}

enum SocialService {
  x
  instagram
  youtube
  tiktok
  github
  discord
  facebook
  linkedin
  bluesky
  threads
  note
  website
  other
}

enum AdminRole {
  moderator
  admin
}

enum ProfileStatus {
  active
  hidden
  suspended
}

enum AudioModerationStatus {
  active
  hidden
  removed
}

enum SocialLinkModerationStatus {
  active
  hidden
}

model AdminUser {
  id        String    @id @default(uuid())
  authId    String    @unique
  role      AdminRole @default(moderator)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Profile {
  id          String                @id @default(uuid())
  userId      String                @unique
  authId      String?               @unique
  status      ProfileStatus         @default(active)
  theme       Theme                 @default(normal)
  displayName String
  bio         String
  audioUrl    String
  audioTitle  String
  audioStatus AudioModerationStatus @default(active)
  sns         SocialLink[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status])
  @@index([audioStatus])
}

model SocialLink {
  id        String                     @id @default(uuid())
  profile   Profile                    @relation(fields: [profileId], references: [id])
  profileId String
  service   SocialService
  url       String
  label     String
  sortOrder Int                        @default(0)
  status    SocialLinkModerationStatus @default(active)

  @@index([profileId])
  @@index([status])
}
