// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  normal
  dark
  light
  colorful
}

enum SocialService {
  x
  instagram
  youtube
  tiktok
  github
  discord
  facebook
  linkedin
  bluesky
  threads
  note
  website
  other
}

enum AdminRole {
  moderator
  admin
}

enum ProfileStatus {
  active
  hidden
  suspended
}

enum AudioModerationStatus {
  active
  hidden
  removed
}

enum SocialLinkModerationStatus {
  active
  hidden
}

enum ModerationTargetType {
  profile
  audio
  socialLink
}

enum ModerationActionType {
  hide
  restore
  suspend
  remove
}

model AdminUser {
  id                String             @id @default(uuid()) @db.Uuid
  authId            String             @unique
  role              AdminRole          @default(moderator)
  isActive          Boolean            @default(true)
  moderationActions ModerationAction[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model ModerationAction {
  id             String               @id @default(uuid()) @db.Uuid
  adminUser      AdminUser            @relation(fields: [adminUserId], references: [id])
  adminUserId    String               @db.Uuid
  profileId      String
  targetType     ModerationTargetType
  targetId       String
  action         ModerationActionType
  previousStatus String               @db.VarChar(32)
  newStatus      String               @db.VarChar(32)
  reason         String               @db.VarChar(500)
  createdAt      DateTime             @default(now())

  @@index([profileId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([adminUserId, createdAt])
}

model Profile {
  id          String                @id @default(uuid())
  userId      String                @unique
  authId      String?               @unique
  status      ProfileStatus         @default(active)
  theme       Theme                 @default(normal)
  displayName String
  bio         String
  audioUrl    String
  audioKey    String                @default("")
  audioTitle  String
  audioStatus AudioModerationStatus @default(active)
  sns         SocialLink[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status])
  @@index([audioStatus])
}

model SocialLink {
  id        String                     @id @default(uuid())
  profile   Profile                    @relation(fields: [profileId], references: [id])
  profileId String
  service   SocialService
  url       String
  label     String
  sortOrder Int                        @default(0)
  status    SocialLinkModerationStatus @default(active)

  @@index([profileId])
  @@index([status])
}
