// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  normal
  dark
  light
  colorful
}

enum SocialService {
  x
  instagram
  youtube
  tiktok
  github
  discord
  facebook
  linkedin
  bluesky
  threads
  note
  website
  other
}

enum AdminRole {
  moderator
  admin
}

enum ProfileStatus {
  active
  hidden
  suspended
}

enum AudioModerationStatus {
  active
  hidden
  removed
}

enum SocialLinkModerationStatus {
  active
  hidden
}

enum ModerationTargetType {
  profile
  audio
  socialLink
}

enum ModerationActionType {
  hide
  restore
  suspend
  scheduleDeletion
  remove
}

enum AccountModerationStatus {
  active
  suspended
  deletionPending
}

enum RegistrationBanStatus {
  active
  revoked
}

enum RegistrationBanIdentifierType {
  email
  providerIdentity
}

enum ModerationReasonCode {
  inappropriateContent
  copyrightConcern
  harassment
  unsafeLink
  serviceMismatch
  impersonation
  threatOrPersonalData
  unofficialThirdPartyProfile
  politicalReligiousPromotion
  other
}

enum ModerationReviewMode {
  postReview
  preReview
}

enum ModerationCaseStatus {
  correctionRequired
  postReviewPending
  preReviewPending
  confirmed
}

enum ModerationSnapshotKind {
  reported
  corrected
}

enum ModerationActorType {
  admin
  user
  system
}

enum ModerationRequestKind {
  inquiry
  accountAppeal
}

enum ModerationRequestStatus {
  pending
  resolved
  rejected
}

enum ModerationCaseEventType {
  created
  contentChanged
  contentDeleted
  statusChanged
  reviewApproved
  reviewRejected
  accountSuspended
  appealSubmitted
  accountRestored
  deletionScheduled
  autoConfirmed
}

enum ReportReason {
  inappropriate_audio
  harassment
  unsafe_link
  impersonation
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

enum ModerationViolationEventType {
  confirmed
  revoked
}

enum IdentityVerificationRequestStatus {
  pending
  verified
  rejected
  expired
}

model AdminUser {
  id                                   String                        @id @default(uuid()) @db.Uuid
  authId                               String                        @unique
  role                                 AdminRole                     @default(moderator)
  isActive                             Boolean                       @default(true)
  moderationActions                    ModerationAction[]
  reviewedReports                      ContentReport[]               @relation("ReportReviewer")
  reportStatusEvents                   ContentReportStatusEvent[]
  violationEvents                      ModerationViolationEvent[]
  reviewedIdentityVerificationRequests IdentityVerificationRequest[]
  createdAt                            DateTime                      @default(now())
  updatedAt                            DateTime                      @updatedAt
}

model ModerationAction {
  id             String               @id @default(uuid()) @db.Uuid
  adminUser      AdminUser?           @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminUserId    String?              @db.Uuid
  actorType      ModerationActorType  @default(admin)
  profileId      String
  targetType     ModerationTargetType
  targetId       String
  action         ModerationActionType
  previousStatus String               @db.VarChar(32)
  newStatus      String               @db.VarChar(32)
  reason         String               @db.VarChar(500)
  createdAt      DateTime             @default(now())
  notification   UserNotification?

  @@index([profileId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([adminUserId, createdAt])
}

model ModerationCase {
  id                           String                        @id @default(uuid()) @db.Uuid
  profile                      Profile                       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId                    String
  targetType                   ModerationTargetType
  targetId                     String
  reasonCode                   ModerationReasonCode
  reviewMode                   ModerationReviewMode
  status                       ModerationCaseStatus          @default(correctionRequired)
  userMessage                  String                        @db.VarChar(500)
  reviewDueAt                  DateTime                      @default(dbgenerated("(CURRENT_TIMESTAMP + '60 days'::interval)"))
  retentionExpiresAt           DateTime                      @default(dbgenerated("(CURRENT_TIMESTAMP + '60 days'::interval)"))
  resolvedAt                   DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  snapshots                    ModerationSnapshot[]
  events                       ModerationCaseEvent[]
  violationEvents              ModerationViolationEvent[]
  identityVerificationRequests IdentityVerificationRequest[]

  @@index([profileId, status, createdAt])
  @@index([status, reviewDueAt])
  @@index([retentionExpiresAt])
  @@index([targetType, targetId, createdAt])
}

model ModerationViolationEvent {
  id                       String                       @id @default(uuid()) @db.Uuid
  profile                  Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId                String
  moderationCase           ModerationCase               @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)
  moderationCaseId         String                       @db.Uuid
  adminUser                AdminUser?                   @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminUserId              String?                      @db.Uuid
  adminAuthId              String?                      @db.VarChar(128)
  adminRole                AdminRole?
  eventType                ModerationViolationEventType
  reasonCode               ModerationReasonCode
  originalViolationEvent   ModerationViolationEvent?    @relation("ViolationRevocation", fields: [originalViolationEventId], references: [id], onDelete: Cascade)
  originalViolationEventId String?                      @db.Uuid
  revocationEvents         ModerationViolationEvent[]   @relation("ViolationRevocation")
  suspensionTriggered      Boolean                      @default(false)
  note                     String                       @db.VarChar(500)
  createdAt                DateTime                     @default(now())

  @@index([profileId, reasonCode, eventType, createdAt], map: "ViolationEvent_profile_reason_type_created_idx")
  @@index([moderationCaseId, createdAt], map: "ViolationEvent_case_created_idx")
  @@index([originalViolationEventId], map: "ViolationEvent_original_idx")
  @@index([adminUserId, createdAt], map: "ViolationEvent_admin_created_idx")
}

model ModerationSnapshot {
  id               String                 @id @default(uuid()) @db.Uuid
  moderationCase   ModerationCase         @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)
  moderationCaseId String                 @db.Uuid
  kind             ModerationSnapshotKind
  content          Json
  contentHash      String?                @db.VarChar(128)
  storageObjectKey String?                @db.VarChar(1024)
  expiresAt        DateTime
  createdAt        DateTime               @default(now())

  @@index([moderationCaseId, kind, createdAt])
  @@index([expiresAt])
}

model PendingR2ObjectDeletion {
  id            String    @id @default(uuid()) @db.Uuid
  objectKey     String    @unique @db.VarChar(1024)
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  lastAttemptAt DateTime? @db.Timestamptz(3)
  lastError     String?   @db.VarChar(2000)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@index([nextAttemptAt, updatedAt])
}

model ModerationCaseEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  moderationCase   ModerationCase          @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)
  moderationCaseId String                  @db.Uuid
  eventType        ModerationCaseEventType
  actorType        ModerationActorType
  actorId          String?                 @db.VarChar(128)
  previousStatus   ModerationCaseStatus?
  newStatus        ModerationCaseStatus?
  details          Json?
  createdAt        DateTime                @default(now())

  @@index([moderationCaseId, createdAt])
  @@index([eventType, createdAt])
}

model ContentReport {
  id                    String                     @id @default(uuid()) @db.Uuid
  profile               Profile                    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId             String
  reason                ReportReason
  details               String                     @default("") @db.VarChar(500)
  status                ReportStatus               @default(pending)
  reviewedByAdminUser   AdminUser?                 @relation("ReportReviewer", fields: [reviewedByAdminUserId], references: [id], onDelete: SetNull)
  reviewedByAdminUserId String?                    @db.Uuid
  reviewedAt            DateTime?
  reviewNote            String                     @default("") @db.VarChar(500)
  statusEvents          ContentReportStatusEvent[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([profileId, createdAt])
  @@index([reviewedByAdminUserId])
}

model ContentReportStatusEvent {
  id             String        @id @default(uuid()) @db.Uuid
  report         ContentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId       String        @db.Uuid
  adminUser      AdminUser?    @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminUserId    String?       @db.Uuid
  adminAuthId    String?       @db.VarChar(128)
  adminRole      AdminRole?
  previousStatus ReportStatus?
  newStatus      ReportStatus
  note           String        @db.VarChar(500)
  isBackfilled   Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([reportId, createdAt(sort: Desc)])
  @@index([adminUserId, createdAt(sort: Desc)])
}

model Profile {
  id                           String                        @id @default(uuid())
  userId                       String                        @unique
  authId                       String?                       @unique
  status                       ProfileStatus                 @default(active)
  accountModerationStatus      AccountModerationStatus       @default(active)
  suspensionAppealDueAt        DateTime?
  deletionScheduledAt          DateTime?
  deletionProcessingStartedAt  DateTime?
  theme                        Theme                         @default(normal)
  displayName                  String
  bio                          String
  audioUrl                     String
  audioKey                     String                        @default("")
  audioContentHash             String?                       @db.VarChar(64)
  audioTitle                   String
  audioStatus                  AudioModerationStatus         @default(active)
  sns                          SocialLink[]
  reports                      ContentReport[]
  notifications                UserNotification[]
  moderationCases              ModerationCase[]
  violationEvents              ModerationViolationEvent[]
  moderationRequests           ModerationRequest[]
  identityVerificationRequests IdentityVerificationRequest[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@index([status])
  @@index([audioStatus])
  @@index([accountModerationStatus, suspensionAppealDueAt])
  @@index([deletionScheduledAt])
  @@index([accountModerationStatus, deletionProcessingStartedAt])
}

model AccountDeletionRecord {
  id                       String                      @id @default(uuid()) @db.Uuid
  formerAuthId             String                      @unique @db.Uuid
  reason                   String                      @db.VarChar(500)
  deletedAt                DateTime?
  pendingStorageObjectKeys String[]
  banStatus                RegistrationBanStatus       @default(active)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  bannedIdentifiers        RegistrationBanIdentifier[]

  @@index([banStatus, deletedAt])
}

model RegistrationBanIdentifier {
  id                      String                        @id @default(uuid()) @db.Uuid
  accountDeletionRecord   AccountDeletionRecord         @relation(fields: [accountDeletionRecordId], references: [id], onDelete: Cascade)
  accountDeletionRecordId String                        @db.Uuid
  identifierType          RegistrationBanIdentifierType
  provider                String?                       @db.VarChar(64)
  fingerprint             String                        @unique @db.Char(64)
  createdAt               DateTime                      @default(now())

  @@index([accountDeletionRecordId, createdAt])
}

model ModerationRequest {
  id              String                  @id @default(uuid()) @db.Uuid
  profile         Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String
  kind            ModerationRequestKind
  status          ModerationRequestStatus @default(pending)
  message         String                  @db.VarChar(500)
  responseMessage String                  @default("") @db.VarChar(500)
  resolvedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([profileId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model IdentityVerificationRequest {
  id                    String                            @id @default(uuid()) @db.Uuid
  profile               Profile                           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId             String
  moderationCase        ModerationCase                    @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)
  moderationCaseId      String                            @db.Uuid
  socialLink            SocialLink?                       @relation(fields: [socialLinkId], references: [id], onDelete: SetNull)
  socialLinkId          String?
  socialUrl             String                            @db.VarChar(2048)
  plannedContent        String                            @db.VarChar(500)
  status                IdentityVerificationRequestStatus @default(pending)
  postingDeadlineAt     DateTime                          @db.Timestamptz(3)
  reviewedByAdminUser   AdminUser?                        @relation(fields: [reviewedByAdminUserId], references: [id], onDelete: SetNull)
  reviewedByAdminUserId String?                           @db.Uuid
  reviewNote            String                            @default("") @db.VarChar(500)
  reviewedAt            DateTime?                         @db.Timestamptz(3)
  createdAt             DateTime                          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                          @updatedAt @db.Timestamptz(3)

  @@index([profileId, createdAt(sort: Desc)])
  @@index([moderationCaseId, createdAt(sort: Desc)])
  @@index([socialLinkId])
  @@index([status, postingDeadlineAt])
  @@index([reviewedByAdminUserId, reviewedAt])
}

model UserNotification {
  id                 String           @id @default(uuid()) @db.Uuid
  profile            Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId          String
  moderationAction   ModerationAction @relation(fields: [moderationActionId], references: [id], onDelete: Cascade)
  moderationActionId String           @unique @db.Uuid
  title              String           @db.VarChar(100)
  message            String           @db.VarChar(500)
  readAt             DateTime?
  createdAt          DateTime         @default(now())

  @@index([profileId, readAt, createdAt(sort: Desc)])
}

model SocialLink {
  id                           String                        @id @default(uuid())
  profile                      Profile                       @relation(fields: [profileId], references: [id])
  profileId                    String
  service                      SocialService
  url                          String
  label                        String
  sortOrder                    Int                           @default(0)
  status                       SocialLinkModerationStatus    @default(active)
  identityVerificationRequests IdentityVerificationRequest[]

  @@index([profileId])
  @@index([status])
}

model RateLimitCounter {
  scope     String   @db.VarChar(64)
  keyHash   String   @map("key_hash") @db.Char(64)
  count     Int
  resetAt   DateTime @map("reset_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([scope, keyHash])
  @@index([resetAt], map: "RateLimitCounter_reset_at_idx")
  @@map("RateLimitCounter")
}
